import matplotlib.pyplot as plt
import numpy as np
x = range(1, 6)
y = [1, 4, 6, 8, 4]
plt.fill_between(x, y, color="skyblue", alpha=0.4) # Fills the area below the line
plt.plot(x, y, color="Slateblue", alpha=0.6)      # Optional: adds the boundary line
plt.title("Basic Area Chart with Matplotlib")
plt.xlabel("X-axis Label")
plt.ylabel("Y-axis Label")
plt.show()
