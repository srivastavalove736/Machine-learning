from sklearn.metrics import accuracy_score, precision_score, recall_score, f1_score

# Sample ground truth and predictions
y_true = [0, 1, 1, 0, 1, 1, 0, 0, 1, 0]
y_pred = [0, 1, 0, 0, 1, 1, 0, 1, 0, 0]

# 1. Accuracy: Overall percentage of correct predictions
accuracy = accuracy_score(y_true, y_pred)

# 2. Precision: Of all positive predictions, how many were actually correct?
precision = precision_score(y_true, y_pred)

# 3. Recall: Of all actual positives, how many did the model find?
recall = recall_score(y_true, y_pred)

# 4. F1 Score: The harmonic mean of precision and recall (balances both)
f1 = f1_score(y_true, y_pred)

print(f"Accuracy: {accuracy:.2f}")
print(f"Precision: {precision:.2f}")
print(f"Recall: {recall:.2f}")
print(f"F1 Score: {f1:.2f}")
