import numpy as np
def sigmoid(x):
    return 1 / (1 + np.exp(-x))

X = np.array([[0,0], [0,1], [1,0], [1,1]])
y = np.array([[0], [0], [0], [1]])

weights = np.array([[0.5], [0.5]])
bias = -0.75
learning_rate = 0.1

for epoch in range(100):
    for i in range(len(X)):
        z = np.dot(X[i], weights) + bias
        prediction = sigmoid(z)
        error = y[i] - prediction
        weights += X[i].reshape(2,1) * error * learning_rate
        bias += error * learning_rate
print("Testing AND Gate:")
for i in range(len(X)):
    print(f"Input: {X[i]} - Predicted: {int(sigmoid(np.dot(X[i], weights) + bias) > 0.5)}")
