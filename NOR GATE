import numpy as np

def step_function(x):
    return 1 if x >= 0 else 0

def nor_gate(inputs):
    weights = np.array([-1, -1])
    bias = 0.5
    
    dot_product = np.dot(inputs, weights) + bias
    return step_function(dot_product)

inputs = [np.array([0, 0]), np.array([0, 1]), np.array([1, 0]), np.array([1, 1])]
for i in inputs:
    print(f"NOR{i} = {nor_gate(i)}")
