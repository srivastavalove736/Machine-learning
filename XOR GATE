import numpy as np
from sklearn.neural_network import MLPClassifier

X = np.array([[0, 0], [0, 1], [1, 0], [1, 1]])
y = np.array([0, 1, 1, 0])

mlp = MLPClassifier(solver='lbfgs', 
                    activation='logistic', 
                    hidden_layer_sizes=(2,), 
                    max_iter=1000, 
                    random_state=1)

mlp.fit(X, y)
print("XOR Gate Predictions (Scikit-Learn):")
predictions = mlp.predict(X)
for val, pred in zip(X, predictions):
    print(f"Input: {val} -> Predicted Output: {pred}")
