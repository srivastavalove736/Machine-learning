from sklearn.linear_model import SGDClassifier
from sklearn.datasets import make_blobs
import matplotlib.pyplot as plt
import numpy as np

# 1. Create linearly separable data
X, y = make_blobs(n_samples=50, centers=2, random_state=0, cluster_std=0.60)

# 2. Train a Linear Model (SVM-like by default)
clf = SGDClassifier(loss='hinge', max_iter=1000)
clf.fit(X, y)

# 3. Predict a new point
new_point = np.array([[1, 2]])
prediction = clf.predict(new_point)
print(f"Prediction for point {new_point}: Class {prediction}")
